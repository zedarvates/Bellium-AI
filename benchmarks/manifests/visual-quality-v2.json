    "centers_xy": [
      [
        0.25,
        0.3
      ],
      [
        0.5,
        0.5
      ],
      [
        0.75,
        0.7
      ]
    ],
    "hole_sides": [
      3,
      7
    ],
    "primary_baseline": "nearest-original-known-pixel-euclidean",
    "secondary_baseline": "one-pixel-bounding-ring-mean",
    "score_only_masked_pixels": true,
    "severe_error_mae_255": 25.0,
    "gates": {
      "minimum_coverage": 0.8,
      "maximum_accepted_mean_mae_255": 12.0,
      "minimum_primary_baseline_improvement": 0.1,
      "maximum_bad_accept_rate": 0.05,
      "maximum_p95_seconds": 1.0,
      "all_known_pixels_preserved": true
    }
  },
  "cutout": {
    "silhouette_canvas": [
      128,
      128
    ],
    "foreground_color": [
      210,
      50,
      40
    ],
    "backgrounds": [
      [
        255,
        255,
        255
      ],
      [
        10,
        20,
        200
      ]
    ],
    "minimum_mask_iou": 0.98,
    "minimum_coverage": 1.0,
    "low_contrast_background": [
      205,
      45,
      40
    ],
    "low_contrast_must_abstain": true,
    "photographs_have_no_cutout_ground_truth": true
  },
  "authority": "consultative-only",
  "data_policy": "New photographs held out from development; no tuning or training on v2, no authority promotion.",
  "threshold_note": "Engineering acceptance gates chosen before scoring; not universal perceptual standards",
